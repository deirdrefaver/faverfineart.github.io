{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buy.faverfineart.com/paintings.schema.json",
  "title": "Faver Fine Art painting catalog",
  "type": "object",
  "required": ["artist", "email", "phone", "paintings"],
  "additionalProperties": false,
  "properties": {
    "artist": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "minLength": 1
    },
    "paintings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "medium", "size", "price", "description", "sold"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "medium": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sold": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
